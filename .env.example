# GeoSentry Environment Configuration Template
DATABASE_URL=postgresql://geosentry:your_password@localhost:5432/geosentry_db
PORT=3000

# Pencarian X/Instagram/TikTok memakai topik tren terbaru melalui feed publik.
# Pencarian bukti sosial memeriksa hingga 140 klaim unik per siklus; nilainya
# dapat diturunkan bila jaringan mesin lambat.
# RSSHub dapat berubah atau membatasi rute tertentu.
GEOSENTRY_RSSHUB_BASES=https://rsshub.app,https://rsshub.rssforever.com
GEOSENTRY_SOCIAL_CLAIM_SEARCH_LIMIT=140
